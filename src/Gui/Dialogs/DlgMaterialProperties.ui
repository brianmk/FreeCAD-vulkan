      <item row="1" column="0">
       <widget class="QLabel" name="textureMappingLabel">
        <property name="text">
         <string>Mapping</string>
        </property>
        <property name="toolTip">
         <string>How the texture image is projected onto the shape. Box maps each face from the closest axis-aligned plane; Planar projects the object X/Y coordinates.</string>
        </property>
