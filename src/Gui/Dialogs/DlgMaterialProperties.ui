      <item row="0" column="0">
       <widget class="QLabel" name="textureSizeLabel">
        <property name="text">
         <string>Texture size</string>
        </property>
        <property name="toolTip">
         <string>Real-world size spanned by one tile of the texture image. Bigger values stretch the texture; smaller values repeat it more densely.</string>
