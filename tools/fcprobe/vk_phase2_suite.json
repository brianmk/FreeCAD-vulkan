{
  "description": "Phase 2 external-tooling gate: the diagnostics probe must pass (a) on the real device, (b) under each capability-removal device profile (Vulkan Profiles fallback), and (c) while a GFXReconstruct capture is recorded.  Replay the capture separately with `freecad_probe.py replay --wsi wayland`.",
  "cases": [
    {
      "name": "default",
      "script": "vk_diag_probe.py",
      "profile": "vulkan",
      "env": {
        "FC_VULKAN_BACKEND_DEBUG": "1",
        "FC_VULKAN_DEBUG_UTILS": "1",
        "FC_VULKAN_GPU_TIMING": "1",
        "FC_VULKAN_PIPELINE_FEEDBACK": "1"
      },
      "timeout": 240
    },
    {
      "name": "device-no-ray-tracing",
      "script": "vk_diag_probe.py",
      "profile": "vulkan",
      "device_profile": "no-ray-tracing",
      "env": {
        "FC_VULKAN_BACKEND_DEBUG": "1",
        "FC_VULKAN_DEBUG_UTILS": "1",
        "FC_VULKAN_GPU_TIMING": "1",
        "FC_VULKAN_PIPELINE_FEEDBACK": "1"
      },
      "timeout": 240
    },
    {
      "name": "device-no-descriptor-indexing",
      "script": "vk_diag_probe.py",
      "profile": "vulkan",
      "device_profile": "no-descriptor-indexing",
      "env": {
        "FC_VULKAN_BACKEND_DEBUG": "1",
        "FC_VULKAN_DEBUG_UTILS": "1",
        "FC_VULKAN_GPU_TIMING": "1",
        "FC_VULKAN_PIPELINE_FEEDBACK": "1"
      },
      "timeout": 240
    },
    {
      "name": "device-portability",
      "script": "vk_diag_probe.py",
      "profile": "vulkan",
      "device_profile": "portability",
      "env": {
        "FC_VULKAN_BACKEND_DEBUG": "1",
        "FC_VULKAN_DEBUG_UTILS": "1",
        "FC_VULKAN_GPU_TIMING": "1",
        "FC_VULKAN_PIPELINE_FEEDBACK": "1"
      },
      "timeout": 240
    },
    {
      "name": "device-desktop-baseline-2022",
      "script": "vk_diag_probe.py",
      "profile": "vulkan",
      "device_profile": "desktop-baseline-2022",
      "env": {
        "FC_VULKAN_BACKEND_DEBUG": "1",
        "FC_VULKAN_DEBUG_UTILS": "1",
        "FC_VULKAN_GPU_TIMING": "1",
        "FC_VULKAN_PIPELINE_FEEDBACK": "1"
      },
      "timeout": 240
    },
    {
      "name": "device-minimum-1-2",
      "script": "vk_diag_probe.py",
      "profile": "vulkan",
      "device_profile": "minimum-1-2",
      "env": {
        "FC_VULKAN_BACKEND_DEBUG": "1",
        "FC_VULKAN_DEBUG_UTILS": "1",
        "FC_VULKAN_GPU_TIMING": "1",
        "FC_VULKAN_PIPELINE_FEEDBACK": "1"
      },
      "timeout": 240
    },
    {
      "name": "device-roadmap-2022",
      "script": "vk_diag_probe.py",
      "profile": "vulkan",
      "device_profile": "roadmap-2022",
      "env": {
        "FC_VULKAN_BACKEND_DEBUG": "1",
        "FC_VULKAN_DEBUG_UTILS": "1",
        "FC_VULKAN_GPU_TIMING": "1",
        "FC_VULKAN_PIPELINE_FEEDBACK": "1"
      },
      "timeout": 240
    },
    {
      "name": "gfxreconstruct-capture",
      "script": "vk_diag_probe.py",
      "profile": "vulkan",
      "gfxreconstruct": true,
      "gfxreconstruct_frames": "1-30",
      "env": {
        "FC_VULKAN_BACKEND_DEBUG": "1",
        "FC_VULKAN_DEBUG_UTILS": "1",
        "FC_VULKAN_GPU_TIMING": "1",
        "FC_VULKAN_PIPELINE_FEEDBACK": "1"
      },
      "timeout": 300
    }
  ]
}
